# Copie ce fichier en .env et remplis les valeurs (cp .env.example .env).
# .env est ignoré par git : les vraies clés ne doivent jamais être commitées.

# Supabase > Project Settings > API
SUPABASE_URL=https://ton-projet.supabase.co
# « Secret key » (sb_secret_…) ou « service_role » : côté serveur uniquement
SUPABASE_SECRET_KEY=

# Supabase > Connect > Session pooler > URI (pour npm run db:migrate)
DATABASE_URL=postgresql://postgres.ton-projet:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Facultatif
# PORT=3001
# CORS_ORIGINS=http://localhost:3000
