{
  "name": "pokewish-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/db",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-lambda/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "deploy:lambda": "bash scripts/deploy-lambda.sh",
    "package:lambda": "npm run build:lambda --silent && rm -f lambda.zip && cd dist-lambda && zip -q ../lambda.zip index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@supabase/server": "^1.9.2",
    "hono": "^4.13.16",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
